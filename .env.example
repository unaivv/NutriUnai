# OpenAI API Key (obligatoria para el chat con el plan nutricional)
# Cópialo a .env.local y rellena el valor
OPENAI_API_KEY=

# JWT Secret para autenticación (genera una cadena segura para producción)
# Ejemplo: JWT_SECRET=jqyghGBNub0w5Dr+gHilO6wKdoiYASxNgBNvHUmO7Cs=
JWT_SECRET=

# URL base para producción (opcional, si usas dominio personalizado)
# NEXT_PUBLIC_BASE_URL=https://your-domain.com
