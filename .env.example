# OpenAI API Key (obligatoria para el chat con el plan nutricional)
# Cópialo a .env.local y rellena el valor
OPENAI_API_KEY=

# Gemini API Key (obligatoria para identificar alimentos en fotos)
GEMINI_API_KEY=

# USDA FoodData Central API Key (fallback de macros cuando Open Food Facts no tiene match)
USDA_API_KEY=
